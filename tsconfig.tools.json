{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tools.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["vitest.config.ts", "playwright.config.ts", "tests/e2e", "apps/*/vite.config.ts", "apps/*/vitest.config.ts", "packages/*/vitest.config.ts"]
}
