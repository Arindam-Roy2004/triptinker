{
  "name": "triptinker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Turn a free-form travel brief into an editable, day-by-day itinerary.",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start -w @triptinker/backend",
    "dev": "npm run dev -w @triptinker/backend",
    "build": "npm run build -w @triptinker/frontend",
    "serve": "npm run serve -w @triptinker/backend",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "og": "node scripts/og-image.mjs",
    "deploy": "node scripts/build-vercel.mjs && vercel deploy --prebuilt --prod"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
