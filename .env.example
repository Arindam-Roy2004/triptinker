# Any OpenAI-compatible Chat Completions endpoint works. The key stays on the server.
#
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1        (default)
#   OpenAI      LLM_BASE_URL=https://api.openai.com/v1
#   Groq        LLM_BASE_URL=https://api.groq.com/openai/v1
#   Gemini      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama      LLM_BASE_URL=http://localhost:11434/v1            (no key needed)
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3.8-flash

# Qwen Flash supports reasoning off for fast planning. Thinking counts against the output budget.
# When changing models, check supported effort levels; some require reasoning (use low).
LLM_REASONING_EFFORT=none

# Set to "off" for providers/models that reject response_format: json_object.
# LLM_JSON_MODE=on

# Optional tuning (milliseconds / tokens)
# LLM_FIRST_TOKEN_TIMEOUT_MS=30000
# LLM_IDLE_TIMEOUT_MS=20000
# LLM_TOTAL_TIMEOUT_MS=120000
# LLM_MAX_OUTPUT_TOKENS=6000

# Voice input (the microphone button). Uses the same key and base URL as planning, with a cheap
# audio-capable model: about $0.00005 per short clip on OpenRouter. Set STT_ENABLED=false to hide it.
# STT_MODEL=google/gemini-2.5-flash-lite
# STT_TIMEOUT_MS=20000
# STT_ENABLED=true

# PORT=4317
# RATE_LIMIT_PER_MINUTE=20
# The failure lab is on in development and off in production unless set explicitly.
# ALLOW_SIMULATION=false
